{
  "name": "woodland-woodchuckers-run-club",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-woodchuckers 'node --test tests/firestore.rules.test.mjs'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:dependencies": "npm audit --audit-level=low",
    "pack:resolver": "node scripts/pack-node-resolve-fork.mjs",
    "test:resolver": "node --test tests/node-resolve-fork.test.mjs",
    "test:integration": "firebase emulators:exec --only firestore --project demo-woodchuckers 'vitest run src/services/store/*.integration.test.ts'",
    "check:bundle": "node scripts/check-bundle.mjs",
    "sync:reward-rules": "node scripts/update-reward-rules.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@rollup/plugin-node-resolve": "file:vendor/rollup-plugin-node-resolve-16.0.3-woodchuckers.1.tgz",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "uuid@>=9 <11.1.1": "^11.1.1",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.10.0"
    },
    "@rollup/plugin-node-resolve": "$@rollup/plugin-node-resolve"
  },
  "engines": {
    "node": "^24.12.0"
  }
}
