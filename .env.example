# Woodland Woodchuckers Run Club - Environment Configuration
# NOTE: The app runs 100% locally out-of-the-box using browser storage (zero credit card needed).
# To sync with a free Google Firebase Spark project, fill in these values from your Firebase Console.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Phone notifications (Firebase Cloud Messaging). Public "Web Push certificate" key from
# Firebase console -> Project settings -> Cloud Messaging -> Web configuration -> Generate key pair.
VITE_FIREBASE_VAPID_KEY=your_web_push_public_key
