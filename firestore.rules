rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Data model & privacy summary
    // ===============================================================
    //
    // PUBLIC (anyone can read):
    //   runs/{runId}              Run schedule. Attendees hold memberKey + name only.
    //   routes/{routeId}          GPX route library.
    //   members/{memberKey}       Leaderboard projection. NO email / PII.
    //                             memberKey = sha256("woodchuckers:" + lowercase email) hex.
    //   badges, special_events    Badge catalog.
    //   meetup_events/{runId}     Check-in event for a run (date, routes, window). NO code word.
    //   settings/{id}             Club announcements.
    //
    // PRIVATE (owner + staff only):
    //   users/{email}             Full profile (birthday, city, zip, emergency contact...).
    //   checkins/{runId_email}    Check-in audit log: one per runner per run.
    //   milestone_alerts/{id}     Gear pickup queue (shirt size, email).
    //   legacy_history/{id}       Old-app sign-in dates per legacy name (claimer + staff).
    //
    // SIGNED-IN ONLY:
    //   legacy_index/pool, legacy_profiles/{id}  Old-app names + counts, claim lock.
    //
    // STAFF ONLY:
    //   meetup_secrets/{runId}    { codeWord } for that run's check-in.
    //
    // SIGNED-IN GET ONLY (no listing):
    //   meetup_codes/{sha256(date:WORD)}  { runId, date }: code word -> run, unique per day.
    //
    // Trust model (Spark plan, no Cloud Functions):
    //   - A runner check-in is only accepted when its code word's lookup key
    //     (meetup_codes) points at that run and request.time is inside the
    //     run's checkInOpensAt..checkInClosesAt window.
    //   - A runner may only bump their own run counters in the SAME batch that
    //     creates (or edits) a valid check-in, and the public leaderboard row
    //     must mirror the user doc written in that batch.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() &&
        request.auth.token.get('email', null) is string &&
        request.auth.token.get('email_verified', false) == true;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    function userPath(email) {
      return /databases/$(database)/documents/users/$(email);
    }

    function legacyPath(id) {
      return /databases/$(database)/documents/legacy_profiles/$(id);
    }

    // One check-in per runner per run.
    function checkinPath(runId, email) {
      return /databases/$(database)/documents/checkins/$(runId + '_' + email);
    }

    function eventPath(runId) {
      return /databases/$(database)/documents/meetup_events/$(runId);
    }

    // The club owner account: always an admin, can't be demoted.
    // Everyone else gets admin via role 'admin' on their users doc.
    // Keep in sync with ADMIN_EMAILS in src/utils/roles.ts.
    function isBootstrapAdminEmail() {
      return tokenEmail() in ['woodlandwoodchuckers@gmail.com'];
    }

    function callerRole() {
      return exists(userPath(tokenEmail()))
        ? get(userPath(tokenEmail())).data.get('role', 'member')
        : 'member';
    }

    // Admin = full control: roles, profiles, badges, settings.
    // Recognized via an 'admin' custom claim, the bootstrap club emails, or
    // role 'admin' on the caller's own users doc (only another admin can set it).
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        (hasVerifiedEmail() && (isBootstrapAdminEmail() || callerRole() == 'admin'))
      );
    }

    // Staff = admins and organizers: event-night tools (runs, routes, events,
    // code words, check-ins, gear queue) and read access to the roster.
    function isStaff() {
      return isAdmin() || (isAuthenticated() && (
        request.auth.token.get('organizer', false) == true ||
        (hasVerifiedEmail() && callerRole() == 'organizer')
      ));
    }

    function isUserEmailOwner(email) {
      return hasVerifiedEmail() && tokenEmail() == email.lower();
    }

    // Public, non-reversible-without-guessing leaderboard key for an email.
    // Must match memberKeyFor() in src/utils/memberKey.ts.
    function memberKeyFor(email) {
      return hashing.sha256('woodchuckers:' + email).toHexString().lower();
    }

    function isValidEmail(email) {
      return email is string &&
        email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    function isValidCoordinates(coords) {
      return coords is map &&
        coords.keys().hasOnly(['lat', 'lon']) &&
        coords.keys().hasAll(['lat', 'lon']) &&
        coords.lat is number && coords.lat >= -90 && coords.lat <= 90 &&
        coords.lon is number && coords.lon >= -180 && coords.lon <= 180;
    }

    // ---- Check-in gating ----

    // Code word lookup key: sha256("<date>:<CODEWORD>"). meetup_codes/{key} = { runId, date }.
    // One key per word per day, so a code word is unique within a day and
    // identifies which run the runner is checking into.
    function codeKeyFor(date, codeWord) {
      return hashing.sha256(date + ':' + codeWord.trim().upper()).toHexString().lower();
    }

    function codeWordMatches(runId, date, codeWord) {
      let key = /databases/$(database)/documents/meetup_codes/$(codeKeyFor(date, codeWord));
      return codeWord is string && codeWord.size() >= 1 &&
        exists(key) &&
        get(key).data.runId == runId;
    }

    // A run is live once its code word is saved (codeWordSet != false).
    function isRunLive(runId) {
      let ev = eventPath(runId);
      return exists(ev) && get(ev).data.get('codeWordSet', true) != false;
    }

    function participationAllowed(runId, email) {
      let run = /databases/$(database)/documents/runs/$(runId);
      return legacyClaimsOpen() && exists(run) && !get(run).data.get('deleting', false) &&
        exists(userPath(email)) && !get(userPath(email)).data.get('deleting', false);
    }

    function checkInMetadataMatches(c) {
      let ev = get(eventPath(c.runId)).data;
      return (!('eventTitle' in c) || c.eventTitle == ev.get('title', '')) &&
        (!('eventSpecial' in c) || c.eventSpecial == ev.get('specialEvent', 'none'));
    }
    function validRouteCredit(c) {
      let ev = get(eventPath(c.runId)).data;
      let key = c.distanceChoice is string ? c.distanceChoice : string(c.distanceChoice);
      let route = ev.routes.get(key, null);
      let loops = c.get('loops', 1);
      return route is map && key in ev.activeDistances && loops is int && loops >= 1 && loops <= 20 &&
        // A loop route's maxLoops is the most a runner can log (4 when the route has none saved).
        (route.get('isLoop', false) ? loops <= route.get('maxLoops', 4) : loops == 1) &&
        math.abs(c.actualMiles * 100 - math.round(c.actualMiles * 100)) < 0.000001 &&
        math.round(c.actualMiles * 100) == math.round((loops > 1 ? route.get('baseMiles', route.actualMiles) : route.actualMiles) * loops * 100);
    }

    function isInsideCheckInWindow(runId, date) {
      let ev = get(eventPath(runId)).data;
      return ev.get('codeWordSet', true) != false && ev.date == date &&
        ev.checkInOpensAt is timestamp && ev.checkInClosesAt is timestamp &&
        request.time >= ev.checkInOpensAt && request.time <= ev.checkInClosesAt;
    }

    // The run is over: its check-in window has closed. Past runs can't be edited.
    function runIsOver(runId) {
      let ev = eventPath(runId);
      return exists(ev) &&
        get(ev).data.get('checkInClosesAt', null) is timestamp &&
        request.time > get(ev).data.checkInClosesAt;
    }

    // The code word is locked once the run is live AND its check-in has opened.
    // A run that isn't live has no open check-in, so its code word can still be set.
    function checkInHasOpened(runId) {
      let ev = eventPath(runId);
      return isRunLive(runId) &&
        get(ev).data.get('checkInOpensAt', null) is timestamp &&
        request.time >= get(ev).data.checkInOpensAt;
    }

    // A check-in doc is being created by this batch.
    function isCheckInCreatedInBatch(p) {
      return !exists(p) && existsAfter(p);
    }

    // An existing check-in doc is being edited by this batch.
    function isCheckInEditedInBatch(p) {
      return exists(p) && existsAfter(p) &&
        getAfter(p).data.get('updatedAt', '') != get(p).data.get('updatedAt', '');
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAttendee(a) {
      return a is map &&
        a.keys().hasOnly(['memberId', 'name', 'checkedIn', 'checkedInAt', 'rsvpDate']) &&
        a.keys().hasAll(['memberId', 'name', 'checkedIn', 'rsvpDate']) &&
        a.memberId is string && a.memberId.size() <= 128 &&
        a.name is string && a.name.size() <= 100 &&
        a.checkedIn is bool &&
        a.rsvpDate is string && a.rsvpDate.size() <= 40;
    }

    function isValidRun(data) {
      return data.keys().hasOnly([
               'id', 'title', 'date', 'time', 'locationName', 'meetingCoordinates',
               'address', 'distanceMiles', 'surface', 'elevationGainFt', 'description',
               'routeId', 'routeChoices', 'paceGroups', 'attendees', 'organizerName',
               'completed', 'specialEvent', 'deleting', 'attendeeIds'
             ]) &&
             data.keys().hasAll([
               'id', 'title', 'date', 'time', 'locationName', 'address',
               'distanceMiles', 'surface', 'elevationGainFt', 'description',
               'paceGroups', 'attendees', 'organizerName'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.date is string && data.date.size() >= 8 && data.date.size() <= 25 &&
             data.time is string && data.time.size() >= 1 && data.time.size() <= 30 &&
             data.locationName is string && data.locationName.size() >= 1 && data.locationName.size() <= 200 &&
             data.address is string && data.address.size() <= 300 &&
             data.distanceMiles is number && data.distanceMiles > 0 && data.distanceMiles <= 500 &&
             data.surface is string && data.surface in ['Trail', 'Pavement', 'Mixed', 'Track'] &&
             data.elevationGainFt is number && data.elevationGainFt >= 0 && data.elevationGainFt <= 50000 &&
             data.description is string && data.description.size() <= 2000 &&
             data.paceGroups is list && data.paceGroups.size() <= 20 &&
             data.attendees is list && data.attendees.size() <= 500 &&
             data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 100 &&
             (!('routeId' in data) || (data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 128)) &&
             (!('routeChoices' in data) || (data.routeChoices is list && data.routeChoices.size() <= 20)) &&
             (!('completed' in data) || (data.completed is bool)) &&
             (!('specialEvent' in data) || (data.specialEvent is string && data.specialEvent.size() <= 50)) &&
             (!('deleting' in data) || data.deleting is bool) &&
             (!('attendeeIds' in data) || (data.attendeeIds is list && data.attendeeIds.size() <= 500)) &&
             (!('meetingCoordinates' in data) || isValidCoordinates(data.meetingCoordinates));
    }

    // A runner may only add or remove their own RSVP entry; nothing else on the run changes.
    // attendeeIds lists who has an entry (rules cannot search inside the attendee
    // maps), so a runner already on the list cannot add a second entry.
    function isOwnRsvpToggle(runId) {
      let before = resource.data.attendees;
      let after = request.resource.data.attendees;
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      let myKey = memberKeyFor(tokenEmail());
      let idsBefore = resource.data.get('attendeeIds', []);
      let idsAfter = request.resource.data.get('attendeeIds', []);
      let joined = !(myKey in idsBefore) && idsAfter == idsBefore.concat([myKey]);
      return hasVerifiedEmail() && after is list && after.size() <= 500 && !resource.data.get('deleting', false) && !get(userPath(tokenEmail())).data.get('deleting', false) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'attendeeIds']) &&
        (
          (added.size() == 1 && removed.size() == 0 &&
           after.size() == before.size() + 1 &&
           isValidAttendee(added[0]) && added[0].memberId == myKey && joined && (added[0].checkedIn == false || existsAfter(checkinPath(runId, tokenEmail())))) ||
          (removed.size() == 1 && added.size() == 0 &&
           after.size() == before.size() - 1 &&
           removed[0].memberId == myKey && idsAfter == idsBefore.removeAll([myKey]) && !existsAfter(checkinPath(runId, tokenEmail()))) ||
          (added.size() == 1 && removed.size() == 1 && after.size() == before.size() &&
           added[0].memberId == myKey && removed[0].memberId == myKey &&
           isValidAttendee(added[0]) && added[0].checkedIn == true && (idsAfter == idsBefore || joined) &&
           existsAfter(checkinPath(runId, tokenEmail())))
        );
    }

    function isOwnLegacyClaim(id) {
      let me = tokenEmail();
      return hasVerifiedEmail() && legacyClaimsOpen() && !get(userPath(me)).data.get('deleting', false) &&
        resource.data.get('claimedBy', null) == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt']) &&
        request.resource.data.claimedBy == memberKeyFor(me) &&
        request.resource.data.claimedAt is string &&
        (id in getAfter(userPath(me)).data.get('linkedLegacyIds', [])) &&
        !(id in get(userPath(me)).data.get('linkedLegacyIds', []));
    }

    function isValidGPXRoute(data) {
      return data.keys().hasOnly([
               'id', 'name', 'description', 'distanceMiles', 'elevationGainFt',
               'points', 'surface', 'difficulty', 'customDistanceLabel', 'isLoop',
               'maxLoops', 'directions', 'geoJson', 'externalLinks', 'notes',
               'gpxXml', 'createdAt', 'updatedAt', 'thumbnailUrl', 'referenced'
             ]) &&
             data.keys().hasAll([
               'id', 'name', 'description', 'distanceMiles', 'elevationGainFt',
               'points', 'surface', 'difficulty', 'createdAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.description is string && data.description.size() <= 2000 &&
             data.distanceMiles is number && data.distanceMiles >= 0 && data.distanceMiles <= 500 &&
             data.elevationGainFt is number && data.elevationGainFt >= 0 && data.elevationGainFt <= 50000 &&
             data.points is list && data.points.size() > 0 && data.points.size() <= 5000 &&
             data.surface is string && data.surface in ['Trail', 'Pavement', 'Mixed', 'Track'] &&
             data.difficulty is string && data.difficulty in ['Easy', 'Moderate', 'Challenging'] &&
             data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 40 &&
             (!('customDistanceLabel' in data) || (data.customDistanceLabel is string && data.customDistanceLabel.size() <= 50)) &&
             (!('referenced' in data) || data.referenced is bool) &&
             (!('isLoop' in data) || (data.isLoop is bool)) &&
             (!('maxLoops' in data) || (data.maxLoops is number && data.maxLoops >= 1 && data.maxLoops <= 20)) &&
             (!('directions' in data) || (data.directions is list && data.directions.size() <= 200) || (data.directions is string && data.directions.size() <= 400000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
             (!('gpxXml' in data) || (data.gpxXml is string && data.gpxXml.size() <= 800000)) &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000));
    }

    // Public leaderboard projection. Deliberately has no email or other PII.
    function isValidMember(data) {
      return data.keys().hasOnly([
               'id', 'name', 'avatarUrl', 'totalRuns', 'totalMiles', 'runCount',
               'walkCount', 'petRunCount', 'streak', 'favoritePace',
               'unlockedBadgeIds', 'badgeCounts', 'joinedDate', 'lastCheckInDate', 'streakProofWeek'
             ]) &&
             data.keys().hasAll([
               'id', 'name', 'totalRuns', 'totalMiles', 'streak',
               'favoritePace', 'unlockedBadgeIds', 'joinedDate'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.totalRuns is number && data.totalRuns >= 0 && data.totalRuns <= 100000 &&
             data.totalMiles is number && data.totalMiles >= 0 && data.totalMiles <= 1000000 &&
             data.streak is number && data.streak >= 0 && data.streak <= 10000 &&
             data.favoritePace is string && data.favoritePace.size() >= 1 && data.favoritePace.size() <= 50 &&
             data.unlockedBadgeIds is list && data.unlockedBadgeIds.size() <= 100 &&
             data.joinedDate is string && data.joinedDate.size() >= 4 && data.joinedDate.size() <= 35 &&
             (!('runCount' in data) || data.runCount is number) &&
             (!('walkCount' in data) || data.walkCount is number) &&
             (!('petRunCount' in data) || data.petRunCount is number) &&
             (!('streakProofWeek' in data) || data.streakProofWeek is int) &&
             (!('badgeCounts' in data) || data.badgeCounts is map) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('lastCheckInDate' in data) || (data.lastCheckInDate is string && data.lastCheckInDate.size() <= 30));
    }

    // The leaderboard row must mirror the user doc as it stands after this batch.
    function memberMirrorsUser(data, email) {
      let u = getAfter(userPath(email)).data;
      return data.name == u.displayName &&
        data.totalRuns == u.totalRuns &&
        data.totalMiles == u.totalMiles &&
        data.unlockedBadgeIds == u.unlockedBadgeIds &&
        data.get('badgeCounts', {}) == u.get('badgeCounts', {}) &&
        data.get('streak', 0) == u.get('currentStreakWeeks', 0) && data.get('streakProofWeek', 0) == u.get('streakProofWeek', 0) &&
        data.get('runCount', 0) == u.runCount && data.get('walkCount', 0) == u.walkCount &&
        data.get('petRunCount', 0) == u.get('petRunCount', 0) &&
        data.get('lastCheckInDate', '') == u.get('lastCheckInDate', '');
    }

    function isValidCheckIn(data) {
      return data.keys().hasOnly([
               'id', 'runId', 'date', 'time', 'userEmail', 'activity', 'distanceChoice',
               'actualMiles', 'createdAt', 'updatedAt', 'runnerName', 'routeName',
               'loops', 'withPet', 'source', 'codeWord', 'eventTitle', 'eventSpecial'
             ]) &&
             data.keys().hasAll([
               'id', 'runId', 'date', 'time', 'userEmail', 'activity', 'distanceChoice',
               'actualMiles', 'createdAt', 'updatedAt'
             ]) &&
             data.runId is string && data.runId.size() >= 1 && data.runId.size() <= 128 &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 180 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.time is string && data.time.size() >= 1 && data.time.size() <= 30 &&
             data.userEmail is string && data.userEmail.size() <= 150 && isValidEmail(data.userEmail) &&
             data.activity is string && data.activity in ['running', 'walking'] &&
             (
               (data.distanceChoice is string && data.distanceChoice.size() <= 100) ||
               (data.distanceChoice is number && data.distanceChoice >= 0 && data.distanceChoice <= 100)
             ) &&
             data.actualMiles is number && data.actualMiles >= 0 && data.actualMiles <= 10000 &&
             data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 40 &&
             data.updatedAt is string && data.updatedAt.size() >= 8 && data.updatedAt.size() <= 40 &&
             (!('eventTitle' in data) || (data.eventTitle is string && data.eventTitle.size() <= 150)) &&
             (!('eventSpecial' in data) || (data.eventSpecial is string && data.eventSpecial.size() <= 100)) &&
             (!('runnerName' in data) || (data.runnerName is string && data.runnerName.size() <= 100)) &&
             (!('routeName' in data) || (data.routeName is string && data.routeName.size() <= 150)) &&
             (!('loops' in data) || (data.loops is number && data.loops >= 0 && data.loops <= 20)) &&
             (!('withPet' in data) || (data.withPet is bool)) &&
             (!('codeWord' in data) || (data.codeWord is string && data.codeWord.size() <= 60)) &&
             (!('source' in data) || (data.source is string && data.source in ['pwa', 'admin', 'legacy_import']));
    }

    function isValidUserProfile(data) {
      return data.keys().hasOnly([
               'email', 'firstName', 'lastName', 'displayName', 'shirtSize',
               'pre2021Runs', 'loggedRuns', 'totalRuns', 'totalMiles', 'runCount',
               'walkCount', 'linkedLegacyNames', 'unlockedBadgeIds', 'role',
               'createdAt', 'age', 'birthday', 'city', 'zipCode', 'preferredPace',
               'petRunCount', 'distanceCounts', 'firstRunDate', 'badgeCounts',
               'emergencyContact', 'lastCheckInDate', 'lastCheckInRunId', 'linkedLegacyIds',
               'lastCheckInUpdatedAt', 'legacyEventRuns', 'currentStreakWeeks', 'longestStreakWeeks', 'deleting', 'rewardEpoch', 'streakProofWeek', 'longestStreakProofWeek', 'rewardChanges'
             ]) &&
             data.keys().hasAll([
               'email', 'firstName', 'lastName', 'displayName', 'shirtSize',
               'pre2021Runs', 'loggedRuns', 'totalRuns', 'totalMiles', 'runCount',
               'walkCount', 'linkedLegacyNames', 'unlockedBadgeIds', 'role',
               'createdAt'
             ]) &&
             data.email is string && data.email.size() <= 150 && isValidEmail(data.email) &&
             data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.shirtSize is string && data.shirtSize.size() >= 1 && data.shirtSize.size() <= 50 &&
             data.pre2021Runs is number && data.pre2021Runs >= 0 && data.pre2021Runs <= 100000 &&
             data.loggedRuns is number && data.loggedRuns >= 0 && data.loggedRuns <= 100000 &&
             data.totalRuns is number && data.totalRuns >= 0 && data.totalRuns <= 100000 &&
             data.totalMiles is number && data.totalMiles >= 0 && data.totalMiles <= 1000000 &&
             data.runCount is number && data.runCount >= 0 && data.runCount <= 100000 &&
             data.walkCount is number && data.walkCount >= 0 && data.walkCount <= 100000 &&
             data.linkedLegacyNames is list && data.linkedLegacyNames.size() <= 100 &&
             data.unlockedBadgeIds is list && data.unlockedBadgeIds.size() <= 100 &&
             data.role is string && data.role in ['member', 'organizer', 'admin', 'guest'] &&
             data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 40 &&
             (!('age' in data) || (data.age is number && data.age >= 0 && data.age <= 150)) &&
             (!('birthday' in data) || (data.birthday is string && data.birthday.size() <= 20)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('zipCode' in data) || (data.zipCode is string && data.zipCode.size() <= 20)) &&
             (!('preferredPace' in data) || (data.preferredPace is string && data.preferredPace.size() <= 50)) &&
             (!('petRunCount' in data) || (data.petRunCount is number && data.petRunCount >= 0 && data.petRunCount <= 100000)) &&
             (!('firstRunDate' in data) || (data.firstRunDate is string && data.firstRunDate.size() <= 30)) &&
             (!('lastCheckInDate' in data) || (data.lastCheckInDate is string && data.lastCheckInDate.size() <= 30)) &&
             (!('lastCheckInRunId' in data) || (data.lastCheckInRunId is string && data.lastCheckInRunId.size() <= 128)) &&
             (!('linkedLegacyIds' in data) || (data.linkedLegacyIds is list && data.linkedLegacyIds.size() <= 50)) &&
             (!('legacyEventRuns' in data) || (data.legacyEventRuns is int && data.legacyEventRuns >= 0)) &&
             (!('currentStreakWeeks' in data) || (data.currentStreakWeeks is int && data.currentStreakWeeks >= 0)) &&
             (!('longestStreakWeeks' in data) || (data.longestStreakWeeks is int && data.longestStreakWeeks >= 0)) &&
             (!('distanceCounts' in data) || (data.distanceCounts is map)) &&
             (!('badgeCounts' in data) || (data.badgeCounts is map)) &&
             (!('emergencyContact' in data) || (data.emergencyContact is map)) &&
             (!('deleting' in data) || data.deleting is bool);
    }

    // Fields a runner can never change on their own profile after sign-up.
    function coreProfileFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'email', 'role', 'createdAt', 'deleting', 'rewardEpoch'
      ]);
    }

    // Legacy claim fields: only change through isLegacyClaimBacked (or an admin).
    function legacyFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'pre2021Runs', 'linkedLegacyNames', 'linkedLegacyIds', 'legacyEventRuns'
      ]);
    }

    // A self-created profile starts empty; runs only arrive via claims and check-ins.
    function isFreshProfile(d) {
      return d.pre2021Runs == 0 && d.loggedRuns == 0 && d.totalRuns == 0 &&
        d.totalMiles == 0 && d.runCount == 0 && d.walkCount == 0 &&
        d.linkedLegacyNames.size() == 0 && d.unlockedBadgeIds.size() == 0 &&
        d.get('linkedLegacyIds', []).size() == 0 &&
        d.get('legacyEventRuns', 0) == 0 &&
        d.get('petRunCount', 0) == 0 && d.get('badgeCounts', {}) == {} && d.get('distanceCounts', {}) == {} &&
        d.get('currentStreakWeeks', 0) == 0 && d.get('longestStreakWeeks', 0) == 0 && d.get('rewardEpoch', 0) == 0;
    }

    // Claiming one legacy name: the legacy doc goes from unclaimed to this runner
    // in the same batch, and the totals grow by exactly that name's counts.
    function legacyClaimsOpen() {
      let p = /databases/$(database)/documents/settings/legacy_import;
      return !exists(p) || get(p).data.get('active', false) == false;
    }

    function isLegacyClaimBacked(email) {
      let before = resource.data.get('linkedLegacyIds', []);
      let after = request.resource.data.get('linkedLegacyIds', []);
      let added = after.removeAll(before);
      return legacyClaimsOpen() && !resource.data.get('deleting', false) && added.size() == 1 &&
        after.size() == before.size() + 1 &&
        before.removeAll(after).size() == 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'linkedLegacyIds', 'linkedLegacyNames', 'pre2021Runs', 'legacyEventRuns', 'totalRuns'
        ]) &&
        claimAddsCounts(email, added[0]);
    }

    function claimAddsCounts(email, id) {
      let d = request.resource.data;
      let o = resource.data;
      let lp = getAfter(legacyPath(id)).data;
      return exists(legacyPath(id)) &&
        get(legacyPath(id)).data.get('claimedBy', null) == null &&
        lp.claimedBy == memberKeyFor(email) &&
        d.pre2021Runs == o.pre2021Runs + lp.oldCount &&
        d.get('legacyEventRuns', 0) == o.get('legacyEventRuns', 0) + lp.newCount &&
        d.totalRuns == o.totalRuns + lp.oldCount + lp.newCount;
    }

    // Badges and streaks are recalculated on the client from the runner's dated
    // history (claimed legacy sign-ins + check-ins) after a claim; nothing else changes.
    function rewardPath(email, epoch, kind, key) {
      let textKey = key is string ? key : string(key);
      return /databases/$(database)/documents/reward_proofs/$(email + '_' + string(epoch) + '_' + kind + '_' + textKey);
    }
    function dateWeek(date) {
      let parts = date.split('-');
      return int(math.floor((timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])).toMillis() + 259200000) / 604800000.0));
    }
    function proofDate(s, email) {
      return s.get('checkinId', null) is string ? get(/databases/$(database)/documents/checkins/$(s.checkinId)).data.date : s.event.d;
    }
    function proofWord(s, email) {
      return s.get('checkinId', null) is string ? get(/databases/$(database)/documents/checkins/$(s.checkinId)).data.get('codeWord', '') : s.event.c;
    }
    function proofSourceId(s) {
      return s.get('checkinId', null) is string ? 'checkin:' + s.checkinId :
        'legacy:' + s.legacyId + ':' + s.event.d + ':' + s.event.t + ':' + s.event.c;
    }
    function checkinProofRunOpen(id) {
      let c = get(/databases/$(database)/documents/checkins/$(id)).data;
      let runId = c.get('runId', '');
      return runId == '' || !get(/databases/$(database)/documents/runs/$(runId)).data.get('deleting', false);
    }
    function validRewardSource(s, email) {
      return s is map && (
        (s.keys().hasOnly(['checkinId']) && s.checkinId is string &&
         get(/databases/$(database)/documents/checkins/$(s.checkinId)).data.userEmail == email && checkinProofRunOpen(s.checkinId)) ||
        (s.keys().hasOnly(['legacyId', 'event']) &&
         get(legacyPath(s.legacyId)).data.get('claimedBy', null) == memberKeyFor(email) &&
         s.event in get(/databases/$(database)/documents/legacy_history/$(s.legacyId)).data.events)
      );
    }
    function proofSpecial(s, email, specialId) {
      let word = proofWord(s, email).upper();
      let runId = s.get('checkinId', null) is string ? get(/databases/$(database)/documents/checkins/$(s.checkinId)).data.get('runId', '') : '';
      let event = runId != '' ? get(eventPath(runId)).data : {};
      let c = s.get('checkinId', null) is string ? get(/databases/$(database)/documents/checkins/$(s.checkinId)).data : {};
      let title = c.get('eventTitle', event.get('title', '')).lower();
      let special = c.get('eventSpecial', event.get('specialEvent', ''));
      return (specialId != 'none' && special == specialId) ||
        (specialId == 'turkey_trot' && (word.matches('.*TURKEY.*') || title.matches('.*turkey.*'))) ||
        (specialId == 'halloween' && (word.matches('.*HALLOWEEN.*') || word.matches('.*SPOOKY.*') || title.matches('.*halloween.*'))) ||
        (specialId == 'anniversary' && (word.matches('.*ANNIVERSARY.*') || title.matches('.*anniversary.*')));
    }
    function validWeekProof(d, id) {
      let previous = rewardPath(d.userEmail, d.epoch, 'week', d.week - 1);
      return d.keys().hasOnly(['userEmail', 'epoch', 'kind', 'week', 'count', 'source']) &&
        d.week is int && d.week == dateWeek(proofDate(d.source, d.userEmail)) &&
        id == d.userEmail + '_' + string(d.epoch) + '_week_' + string(d.week) &&
        d.count is int && d.count > 0 && d.count <= 10000 &&
        d.count == (exists(previous) ? get(previous).data.count + 1 : 1);
    }
    function validSpecialProof(d, id) {
      let old = resource == null ? [] : resource.data.sources;
      return d.keys().hasOnly(['userEmail', 'epoch', 'kind', 'specialId', 'count', 'sources', 'sourceId', 'source']) &&
        d.specialId is string && d.specialId.size() <= 100 &&
        id == d.userEmail + '_' + string(d.epoch) + '_special_' + d.specialId &&
        d.sourceId == proofSourceId(d.source) && !(d.sourceId in old) &&
        d.sources == old.concat([d.sourceId]) && d.sources.size() <= 5000 &&
        d.count == d.sources.size() && proofSpecial(d.source, d.userEmail, d.specialId);
    }
    function derivedUnchanged(d, o) {
      return d.get('badgeCounts', {}) == o.get('badgeCounts', {}) && d.unlockedBadgeIds == o.unlockedBadgeIds &&
        d.get('currentStreakWeeks', 0) == o.get('currentStreakWeeks', 0) && d.get('longestStreakWeeks', 0) == o.get('longestStreakWeeks', 0) &&
        d.get('streakProofWeek', 0) == o.get('streakProofWeek', 0) && d.get('longestStreakProofWeek', 0) == o.get('longestStreakProofWeek', 0);
    }
    function clubWeekNow() {
      let year = request.time.year();
      let march = timestamp.date(year, 3, 1);
      let november = timestamp.date(year, 11, 1);
      let starts = timestamp.date(year, 3, 8 + (7 - march.dayOfWeek()) % 7) + duration.value(10, 'h');
      let ends = timestamp.date(year, 11, 1 + (7 - november.dayOfWeek()) % 7) + duration.value(9, 'h');
      let offset = request.time >= starts && request.time < ends ? 25200000 : 28800000;
      return int(math.floor((request.time.toMillis() - offset + 259200000) / 604800000.0));
    }
    function validStreaks(d, email) {
      let epoch = d.get('rewardEpoch', 0);
      let current = d.get('currentStreakWeeks', 0);
      let longest = d.get('longestStreakWeeks', 0);
      let week = d.get('streakProofWeek', 0);
      let today = clubWeekNow();
      return (longest == 0 || get(rewardPath(email, epoch, 'week', d.longestStreakProofWeek)).data.count == longest) &&
        (current == 0 || (week >= today - 1 && week <= today && get(rewardPath(email, epoch, 'week', week)).data.count == current));
    }
    function builtinBadgeConfig(id) {
      return id == "first-chuck" ? {"type":"attendance"} :
        id == "milestone-5" ? {"type":"milestone","minTotalRuns":5,"isIncremental":true,"step":5} :
        id == "milestone-50" ? {"type":"milestone","minTotalRuns":50,"isIncremental":true,"step":50} :
        id == "milestone-100" ? {"type":"milestone","minTotalRuns":100,"isIncremental":true,"step":100} :
        id == "milestone-200" ? {"type":"milestone","minTotalRuns":200,"isIncremental":true,"step":200} :
        id == "power-walker" ? {"type":"activity","activityType":"walking","activityCount":10,"isIncremental":true,"step":10} :
        id == "pet-runner" ? {"type":"pet","isIncremental":true,"step":1} :
        id == "streak-4" ? {"type":"streak","streakWeeks":4,"isIncremental":true,"step":4} :
        id == "streak-10" ? {"type":"streak","streakWeeks":10,"isIncremental":true,"step":10} :
        id == "special-turkey" ? {"type":"special_event","specialEventId":"turkey_trot","isIncremental":true,"step":1} :
        id == "special-halloween" ? {"type":"special_event","specialEventId":"halloween","isIncremental":true,"step":1} :
        id == "special-anniversary" ? {"type":"special_event","specialEventId":"anniversary","isIncremental":true,"step":1} : {};
    }
    function badgeConfig(id) {
      let p = /databases/$(database)/documents/badges/$(id);
      return exists(p) ? get(p).data.get('triggerConfig', {}) : builtinBadgeConfig(id);
    }
    function positiveRewardLevel(n, step) {
      let level = int(math.floor(n / step));
      return level < 1 ? 1 : level;
    }
    function rewardSteps(n, threshold, cfg) {
      return n < threshold ? 0 : (cfg.get('isIncremental', false) ? positiveRewardLevel(n, cfg.get('step', threshold)) : 1);
    }
    function badgeDistanceKey(cfg) {
      let key = cfg.get('distanceChoice', cfg.get('distanceTier', '3.1'));
      return key is string ? key : string(key);
    }
    function expectedBadgeCount(id, cfg, d, email) {
      let type = cfg.get('type', '');
      return type == 'attendance' ? (d.totalRuns >= 1 ? 1 : 0) :
        type == 'milestone' ? rewardSteps(d.totalRuns, cfg.get('minTotalRuns', 1), cfg) :
        type == 'activity' ? rewardSteps(cfg.get('activityType', 'running') == 'walking' ? d.walkCount : d.runCount, cfg.get('activityCount', 10), cfg) :
        type == 'distance' ? rewardSteps(d.get('distanceCounts', {}).get(badgeDistanceKey(cfg), 0), cfg.get('distanceCount', 1), cfg) :
        type == 'pet' ? d.get('petRunCount', 0) :
        type == 'streak' ? rewardSteps(d.get('longestStreakWeeks', 0), cfg.get('streakWeeks', 4), {'isIncremental': cfg.get('isIncremental', false), 'step': cfg.get('streakWeeks', 4)}) :
        type == 'special_event' ? get(rewardPath(email, d.get('rewardEpoch', 0), 'special', cfg.get('specialEventId', id.matches('^special-.*') ? id.split('special-')[1] : id))).data.count : -1;
    }
    function validBadgeKey(id, d, o, email) {
      let count = d.get('badgeCounts', {}).get(id, 0);
      return count == 0 || count == o.get('badgeCounts', {}).get(id, id in o.unlockedBadgeIds ? 1 : 0) ||
        (count is int && count > 0 && count == expectedBadgeCount(id, badgeConfig(id), d, email));
    }
    function validDerivedRefresh(d, o, email) {
      let changed = d.get('rewardChanges', []);
      return d.unlockedBadgeIds.size() <= 100 && d.get('badgeCounts', {}).size() <= 100 &&
        changed is list && changed.toSet() == d.get('badgeCounts', {}).diff(o.get('badgeCounts', {})).affectedKeys() &&
        d.unlockedBadgeIds.toSet() == d.get('badgeCounts', {}).keys().toSet() &&
        changed.size() <= 2 && validStreaks(d, email) &&
        (changed.size() < 1 || validBadgeKey(changed[0], d, o, email)) &&
        (changed.size() < 2 || validBadgeKey(changed[1], d, o, email));
    }

    function isBadgeRefreshOnly() {
      return legacyClaimsOpen() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'unlockedBadgeIds', 'badgeCounts', 'currentStreakWeeks', 'longestStreakWeeks', 'streakProofWeek', 'longestStreakProofWeek', 'rewardChanges'
      ]) && validDerivedRefresh(request.resource.data, resource.data, tokenEmail());
    }

    function roleChanged() {
      return request.resource.data.get('role', 'member') != resource.data.get('role', 'member');
    }

    // Stats a runner may only change while writing a valid check-in in the same batch.
    function statsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'totalRuns', 'loggedRuns', 'totalMiles', 'runCount', 'walkCount',
        'petRunCount', 'distanceCounts', 'unlockedBadgeIds', 'badgeCounts',
        'lastCheckInUpdatedAt', 'lastCheckInDate', 'lastCheckInRunId', 'firstRunDate', 'currentStreakWeeks', 'longestStreakWeeks', 'streakProofWeek', 'longestStreakProofWeek', 'rewardChanges'
      ]);
    }

    function distanceKeys(miles) {
      let tenths = int(math.round(miles * 10));
      let label = string(int(tenths / 10)) + '.' + string(tenths % 10);
      return [miles <= 2 ? '1' : miles <= 4 ? '3' : '5', label, label + ' mi'];
    }
    function distanceKeyMatches(key, after, before, added, removed) {
      let expected = before.get(key, 0) + (key in added ? 1 : 0) - (key in removed ? 1 : 0);
      return after.get(key, 0) == (expected < 0 ? 0 : expected);
    }
    function distanceCreditMatches(d, o, c, old, isNew) {
      let after = d.get('distanceCounts', {});
      let before = o.get('distanceCounts', {});
      let added = distanceKeys(c.actualMiles);
      let removed = isNew ? [] : distanceKeys(old.actualMiles);
      return after.diff(before).affectedKeys().hasOnly(added.concat(removed)) &&
        distanceKeyMatches(added[0], after, before, added, removed) &&
        distanceKeyMatches(added[1], after, before, added, removed) &&
        distanceKeyMatches(added[2], after, before, added, removed) &&
        (isNew || (distanceKeyMatches(removed[0], after, before, added, removed) &&
         distanceKeyMatches(removed[1], after, before, added, removed) && distanceKeyMatches(removed[2], after, before, added, removed)));
    }
    function checkInProfileCredit(c, id) {
      let before = get(userPath(c.userEmail)).data;
      let after = getAfter(userPath(c.userEmail)).data;
      return after.get('lastCheckInRunId', '') == c.runId && after.get('lastCheckInUpdatedAt', '') == c.updatedAt &&
        before.get('lastCheckInUpdatedAt', '') != c.updatedAt;
    }
    function checkInStatsOnly() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly([
        'totalRuns', 'loggedRuns', 'totalMiles', 'runCount', 'walkCount', 'petRunCount', 'distanceCounts',
        'lastCheckInUpdatedAt', 'lastCheckInDate', 'lastCheckInRunId'
      ]) && d.totalRuns <= 100000 && d.loggedRuns <= 100000 && d.totalMiles <= 1000000 &&
        d.totalMiles >= 0 && d.runCount >= 0 && d.walkCount >= 0 && d.get('petRunCount', 0) >= 0;
    }

    function isStatsChangeBackedByCheckIn(email) {
      let d = request.resource.data;
      let o = resource.data;
      let p = checkinPath(d.get('lastCheckInRunId', ''), email);
      let c = getAfter(p).data;
      let old = exists(p) ? get(p).data : {'actualMiles': 0, 'activity': '', 'withPet': false};
      let added = !exists(p) ? 1 : 0;
      return d.get('lastCheckInRunId', null) is string &&
        d.get('lastCheckInUpdatedAt', '') == c.updatedAt && d.lastCheckInDate == c.date &&
        derivedUnchanged(d, o) && distanceCreditMatches(d, o, c, old, added == 1) && participationAllowed(c.runId, email) &&
        (isCheckInCreatedInBatch(p) || isCheckInEditedInBatch(p)) &&
        d.totalRuns == o.totalRuns + added && d.loggedRuns == o.loggedRuns + added &&
        d.runCount == o.runCount + (c.activity == 'running' ? 1 : 0) - (old.activity == 'running' ? 1 : 0) &&
        d.walkCount == o.walkCount + (c.activity == 'walking' ? 1 : 0) - (old.activity == 'walking' ? 1 : 0) &&
        d.get('petRunCount', 0) == o.get('petRunCount', 0) + (c.get('withPet', false) ? 1 : 0) - (old.get('withPet', false) ? 1 : 0) &&
        math.abs(d.totalMiles * 100 - math.round(d.totalMiles * 100)) < 0.000001 &&
        math.round(d.totalMiles * 100) == math.round(o.totalMiles * 100) + math.round(c.actualMiles * 100) - math.round(old.actualMiles * 100);

    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. RUNS — public schedule. Staff manage runs; runners may only toggle their own RSVP.
    match /runs/{runId} {
      allow read: if true;

      allow create: if isStaff() &&
                       isValidRun(request.resource.data) &&
                       request.resource.data.id == runId;

      // Past runs can't be edited (only their RSVP list, e.g. when a runner is deleted).
      allow update: if request.resource.data.id == resource.data.id &&
                       request.resource.data.id == runId &&
                       (isOwnRsvpToggle(runId) || (isStaff() && isValidRun(request.resource.data) &&
                         (!runIsOver(runId) ||
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'attendeeIds', 'deleting']))));

      // Organizers can delete a run until its check-in opens; after that only an admin can
      // (check-ins, run totals and gear alerts depend on it).
      allow delete: if isAdmin() || (isStaff() && !checkInHasOpened(runId));
    }

    // 2. ROUTES — public library, staff-managed.
    match /routes/{routeId} {
      allow read: if true;

      allow create: if isStaff() &&
                       isValidGPXRoute(request.resource.data) &&
                       request.resource.data.id == routeId;

      allow update: if isStaff() &&
                       isValidGPXRoute(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.id == routeId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (!resource.data.get('referenced', false) ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referenced'])) &&
                       (!resource.data.get('referenced', false) || request.resource.data.referenced == true);

      allow delete: if isStaff() && !resource.data.get('referenced', false);
    }

    // 3. MEMBERS — public leaderboard projection keyed by memberKey (hashed email).
    match /members/{memberKey} {
      allow read: if true;

      allow create, update: if isValidMember(request.resource.data) &&
                               request.resource.data.id == memberKey &&
                               (
                                 (hasVerifiedEmail() &&
                                  memberKey == memberKeyFor(tokenEmail()) &&
                                  memberMirrorsUser(request.resource.data, tokenEmail())) || isAdmin()
                               );

      allow delete: if isAdmin();
    }

    // 4. CHECKINS — private audit log. One per runner per run: doc ID is `${runId}_${email}`.
    match /checkins/{checkinId} {
      // Transactions must be able to establish that a check-in does not exist.
      allow get: if hasVerifiedEmail() && !exists(/databases/$(database)/documents/checkins/$(checkinId));
      allow read: if isStaff() ||
                     (hasVerifiedEmail() && resource.data.userEmail == tokenEmail());

      allow create: if isValidCheckIn(request.resource.data) && validRouteCredit(request.resource.data) && checkInMetadataMatches(request.resource.data) &&
                       checkinId == request.resource.data.runId + '_' + request.resource.data.userEmail &&
                       request.resource.data.id == checkinId &&
                       (
                         (isUserEmailOwner(request.resource.data.userEmail) &&
                          request.resource.data.get('source', 'pwa') == 'pwa' && checkInProfileCredit(request.resource.data, checkinId) &&
                          codeWordMatches(request.resource.data.runId, request.resource.data.date, request.resource.data.get('codeWord', '')) &&
                          isInsideCheckInWindow(request.resource.data.runId, request.resource.data.date)) || (isStaff() && participationAllowed(request.resource.data.runId, request.resource.data.userEmail))
                       );

      allow update: if isValidCheckIn(request.resource.data) && validRouteCredit(request.resource.data) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['id', 'runId', 'date', 'userEmail', 'createdAt', 'eventTitle', 'eventSpecial']) &&
                       (
                         (isUserEmailOwner(resource.data.userEmail) &&
                          request.resource.data.get('source', 'pwa') == 'pwa' && checkInProfileCredit(request.resource.data, checkinId) &&
                          codeWordMatches(request.resource.data.runId, request.resource.data.date, request.resource.data.get('codeWord', '')) &&
                          isInsideCheckInWindow(request.resource.data.runId, request.resource.data.date)) || (isStaff() && participationAllowed(request.resource.data.runId, request.resource.data.userEmail))
                       );

      // Admins only: removing a check-in goes with rolling back that runner's
      // totals, which only an admin can write.
      allow delete: if isAdmin();
    }

    // 5. USERS — private profiles. Doc ID is the lowercase email.
    // Staff can read the roster; only admins can create, edit or delete other
    // people's profiles. Roles change only by an admin, never on your own profile.
    match /users/{email} {
      allow get: if isUserEmailOwner(email) || isStaff();
      allow list: if isStaff();

      allow create: if isValidUserProfile(request.resource.data) &&
                       request.resource.data.email == email &&
                       (
                         (isAdmin() && !isUserEmailOwner(email)) ||
                         (isUserEmailOwner(email) &&
                          isFreshProfile(request.resource.data) &&
                          (request.resource.data.role == 'member' ||
                           (request.resource.data.role == 'admin' && isBootstrapAdminEmail())))
                       );

      allow update: if
        (isUserEmailOwner(email) && coreProfileFieldsUnchanged() &&
          ((legacyFieldsUnchanged() && (
            isBadgeRefreshOnly() ||
            (checkInStatsOnly() && isStatsChangeBackedByCheckIn(email)) ||
            (statsUnchanged() && isValidUserProfile(request.resource.data)))) ||
           (isLegacyClaimBacked(email) && isValidUserProfile(request.resource.data)))) ||
        (isAdmin() && (!isUserEmailOwner(email) || !roleChanged()) && isValidUserProfile(request.resource.data));

      allow delete: if isAdmin() && !isUserEmailOwner(email);
    }

    // 6. BADGES / 7. SPECIAL EVENTS — public catalog, admin-managed.
    match /badges/{badgeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /special_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 8. MILESTONE ALERTS — private gear queue.
    // Runners may create exactly one alert per milestone, only alongside the
    // check-in that brought their total to that milestone.
    match /milestone_alerts/{alertId} {
      allow get: if hasVerifiedEmail() && !exists(/databases/$(database)/documents/milestone_alerts/$(alertId));
      allow read: if isStaff() ||
                     (hasVerifiedEmail() && resource.data.userEmail == tokenEmail());

      allow create: if isStaff() ||
                       (hasVerifiedEmail() &&
                        request.resource.data.keys().hasOnly([
                          'id', 'userEmail', 'runnerName', 'shirtSize', 'milestoneRuns',
                          'milestoneName', 'reward', 'perks', 'date', 'time', 'fulfilled', 'runId'
                        ]) &&
                        request.resource.data.id == alertId &&
                        request.resource.data.userEmail == tokenEmail() &&
                        request.resource.data.milestoneRuns is int &&
                        request.resource.data.milestoneRuns >= 1 &&
                        alertId == 'm' + string(request.resource.data.milestoneRuns) + '_' + tokenEmail() &&
                        request.resource.data.fulfilled == false &&
                        request.resource.data.runId is string &&
                        isCheckInCreatedInBatch(checkinPath(request.resource.data.runId, tokenEmail())) &&
                        getAfter(userPath(tokenEmail())).data.totalRuns == request.resource.data.milestoneRuns);

      allow update, delete: if isStaff();
    }

    // 9. MEETUP EVENTS — public check-in info for one run. Doc ID is the run ID.
    // The code word lives in meetup_secrets (staff) and meetup_codes (lookup key).
    match /meetup_events/{eventId} {
      allow read: if true;
      allow create, update: if isStaff() && !('codeWord' in request.resource.data) &&
                               !runIsOver(eventId) &&
                               // A live run with check-in open can't be switched to "not live"
                               // (that would unlock its code word).
                               (!checkInHasOpened(eventId) ||
                                (request.resource.data.get('codeWordSet', true) != false &&
                                 request.resource.data.checkInOpensAt == resource.data.checkInOpensAt &&
                                 request.resource.data.checkInClosesAt == resource.data.checkInClosesAt &&
                                 request.resource.data.date == resource.data.date));
      allow delete: if isAdmin() || (isStaff() && !checkInHasOpened(eventId));
    }

    // 9b. MEETUP SECRETS — the run's code word, staff only.
    // Can be set or changed until the run is live and its check-in has opened;
    // then it's locked (re-saving the same word is fine).
    match /meetup_secrets/{eventId} {
      allow read: if isStaff();
      allow create: if isStaff() && !checkInHasOpened(eventId);
      allow update: if isStaff() &&
                       (request.resource.data.codeWord == resource.data.codeWord ||
                        !checkInHasOpened(eventId));
      // Same as the event itself: staff until check-in opens, admins afterwards.
      allow delete: if isAdmin() || (isStaff() && !checkInHasOpened(eventId));
    }

    // 9c. MEETUP CODES — lookup key sha256("<date>:<CODEWORD>") -> { runId, date }.
    // Signed-in runners may get a key (to find which run a code word belongs to)
    // but never list them. Creating fails if the word is already used that day.
    match /meetup_codes/{codeKey} {
      allow get: if hasVerifiedEmail();
      allow list: if false;
      allow create: if isStaff() &&
                       request.resource.data.keys().hasOnly(['runId', 'date']) &&
                       request.resource.data.runId is string &&
                       request.resource.data.date is string &&
                       !checkInHasOpened(request.resource.data.runId);
      allow update: if false;
      // Admins may also remove it later, e.g. when deleting a run that already happened.
      allow delete: if isAdmin() || (isStaff() && !checkInHasOpened(resource.data.runId));
    }

    // 10. CLUB SETTINGS — public read, admin write.
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 11. LEGACY (old app) DATA
    // legacy_index/pool: { entries: [{id, name, oldCount, newCount}] } — one read for name search.
    match /legacy_index/{docId} {
      allow read: if hasVerifiedEmail();
      allow write: if isAdmin();
    }

    // legacy_profiles/{id}: one per old sign-in name. claimedBy = claimer's memberKey.
    // A runner can claim an unclaimed name only together with the matching
    // profile update (isLegacyClaimBacked). Only admins unclaim or reassign.
    match /legacy_profiles/{id} {
      allow read: if hasVerifiedEmail();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwnLegacyClaim(id);
    }

    // legacy_history/{id}: { events: [{d, t, c}] } — dated sign-ins since 2021.
    // Private: the claimer and staff only.
    match /legacy_history/{id} {
      allow read: if isStaff() ||
                     (hasVerifiedEmail() &&
                      get(legacyPath(id)).data.get('claimedBy', null) == memberKeyFor(tokenEmail()));
      allow write: if isAdmin();
    }

    // Reward evidence is private, and every source is checked against attendance.
    match /reward_proofs/{proofId} {
      allow get: if hasVerifiedEmail() && !exists(/databases/$(database)/documents/reward_proofs/$(proofId));
      allow read: if (hasVerifiedEmail() && resource.data.userEmail == tokenEmail()) || isStaff();
      allow create, update: if hasVerifiedEmail() && (request.resource.data.userEmail == tokenEmail() || isAdmin()) &&
        !get(userPath(request.resource.data.userEmail)).data.get('deleting', false) && legacyClaimsOpen() &&
        request.resource.data.epoch == get(userPath(request.resource.data.userEmail)).data.get('rewardEpoch', 0) &&
        validRewardSource(request.resource.data.source, request.resource.data.userEmail) &&
        (request.resource.data.kind == 'week' ? validWeekProof(request.resource.data, proofId) :
          request.resource.data.kind == 'special' && validSpecialProof(request.resource.data, proofId));
      allow delete: if isAdmin();
    }

    // 11b. ANNOUNCEMENTS — club announcement feed (the bell). Public read, admins post/delete.
    match /announcements/{id} {
      allow read: if true;
      allow create: if isAdmin() &&
                       request.resource.data.keys().hasOnly(['id', 'title', 'body', 'timestamp', 'sender']) &&
                       request.resource.data.id == id &&
                       request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120 &&
                       request.resource.data.body is string && request.resource.data.body.size() <= 2000 &&
                       request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 40 &&
                       request.resource.data.sender is string && request.resource.data.sender.size() <= 100;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 12. PUSH DEVICES — phones/browsers signed up for club notifications.
    // Doc ID = sha256(FCM token). Sending happens from the Firebase console;
    // these docs only let admins see how many devices are signed up.
    match /push_devices/{deviceId} {
      allow read: if isAdmin();
      // Writing requires the token itself (its hash is the doc ID), so a shared
      // phone can be taken over by whoever is signed in on it.
      allow create, update: if hasVerifiedEmail() &&
                               request.resource.data.keys().hasOnly(['token', 'userEmail', 'memberKey', 'platform', 'updatedAt']) &&
                               request.resource.data.token is string &&
                               request.resource.data.token.size() <= 4096 &&
                               hashing.sha256(request.resource.data.token).toHexString().lower() == deviceId &&
                               request.resource.data.userEmail == tokenEmail() &&
                               request.resource.data.platform in ['ios', 'android', 'desktop'] &&
                               request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() || (hasVerifiedEmail() && resource.data.userEmail == tokenEmail());
    }

    // 13. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
