rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Data model & privacy summary
    // ===============================================================
    //
    // PUBLIC (anyone can read):
    //   runs/{runId}              Run schedule. Attendees hold memberKey + name only.
    //   routes/{routeId}          GPX route library.
    //   members/{memberKey}       Leaderboard projection. NO email / PII.
    //                             memberKey = sha256("woodchuckers:" + lowercase email) hex.
    //   badges, special_events    Badge catalog.
    //   meetup_events/{runId}     Check-in event for a run (date, routes, window). NO code word.
    //   settings/{id}             Club announcements.
    //
    // PRIVATE (owner + staff only):
    //   users/{email}             Full profile (birthday, city, zip, emergency contact...).
    //   checkins/{runId_email}    Check-in audit log: one per runner per run.
    //   milestone_alerts/{id}     Gear pickup queue (shirt size, email).
    //   legacy_history/{id}       Old-app sign-in dates per legacy name (claimer + staff).
    //
    // SIGNED-IN ONLY:
    //   legacy_index/pool, legacy_profiles/{id}  Old-app names + counts, claim lock.
    //
    // STAFF ONLY:
    //   meetup_secrets/{runId}    { codeWord } for that run's check-in.
    //
    // SIGNED-IN GET ONLY (no listing):
    //   meetup_codes/{sha256(date:WORD)}  { runId, date }: code word -> run, unique per day.
    //
    // Trust model (Spark plan, no Cloud Functions):
    //   - A runner check-in is only accepted when its code word's lookup key
    //     (meetup_codes) points at that run and request.time is inside the
    //     run's checkInOpensAt..checkInClosesAt window.
    //   - A runner may only bump their own run counters in the SAME batch that
    //     creates (or edits) a valid check-in, and the public leaderboard row
    //     must mirror the user doc written in that batch.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() &&
        request.auth.token.get('email', null) is string &&
        request.auth.token.get('email_verified', false) == true;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    function userPath(email) {
      return /databases/$(database)/documents/users/$(email);
    }

    function legacyPath(id) {
      return /databases/$(database)/documents/legacy_profiles/$(id);
    }

    // One check-in per runner per run.
    function checkinPath(runId, email) {
      return /databases/$(database)/documents/checkins/$(runId + '_' + email);
    }

    function eventPath(runId) {
      return /databases/$(database)/documents/meetup_events/$(runId);
    }

    // The club owner account: always an admin, can't be demoted.
    // Everyone else gets admin via role 'admin' on their users doc.
    // Keep in sync with ADMIN_EMAILS in src/utils/roles.ts.
    function isBootstrapAdminEmail() {
      return tokenEmail() in ['woodlandwoodchuckers@gmail.com'];
    }

    function callerRole() {
      return exists(userPath(tokenEmail()))
        ? get(userPath(tokenEmail())).data.get('role', 'member')
        : 'member';
    }

    // Admin = full control: roles, profiles, badges, settings.
    // Recognized via an 'admin' custom claim, the bootstrap club emails, or
    // role 'admin' on the caller's own users doc (only another admin can set it).
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        (hasVerifiedEmail() && (isBootstrapAdminEmail() || callerRole() == 'admin'))
      );
    }

    // Staff = admins and organizers: event-night tools (runs, routes, events,
    // code words, check-ins, gear queue) and read access to the roster.
    function isStaff() {
      return isAdmin() || (isAuthenticated() && (
        request.auth.token.get('organizer', false) == true ||
        (hasVerifiedEmail() && callerRole() == 'organizer')
      ));
    }

    function isUserEmailOwner(email) {
      return hasVerifiedEmail() && tokenEmail() == email.lower();
    }

    // Public, non-reversible-without-guessing leaderboard key for an email.
    // Must match memberKeyFor() in src/utils/memberKey.ts.
    function memberKeyFor(email) {
      return hashing.sha256('woodchuckers:' + email).toHexString().lower();
    }

    function isValidEmail(email) {
      return email is string &&
        email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    function isValidCoordinates(coords) {
      return coords is map &&
        coords.keys().hasOnly(['lat', 'lon']) &&
        coords.keys().hasAll(['lat', 'lon']) &&
        coords.lat is number && coords.lat >= -90 && coords.lat <= 90 &&
        coords.lon is number && coords.lon >= -180 && coords.lon <= 180;
    }

    // ---- Check-in gating ----

    // Code word lookup key: sha256("<date>:<CODEWORD>"). meetup_codes/{key} = { runId, date }.
    // One key per word per day, so a code word is unique within a day and
    // identifies which run the runner is checking into.
    function codeKeyFor(date, codeWord) {
      return hashing.sha256(date + ':' + codeWord.trim().upper()).toHexString().lower();
    }

    function codeWordMatches(runId, date, codeWord) {
      let key = /databases/$(database)/documents/meetup_codes/$(codeKeyFor(date, codeWord));
      return codeWord is string && codeWord.size() >= 1 &&
        exists(key) &&
        get(key).data.runId == runId;
    }

    // A run is live once its code word is saved (codeWordSet != false).
    function isRunLive(runId) {
      let ev = eventPath(runId);
      return exists(ev) && get(ev).data.get('codeWordSet', true) != false;
    }

    function isInsideCheckInWindow(runId, date) {
      let ev = eventPath(runId);
      return isRunLive(runId) &&
        get(ev).data.get('date', '') == date &&
        get(ev).data.get('checkInOpensAt', null) is timestamp &&
        get(ev).data.get('checkInClosesAt', null) is timestamp &&
        request.time >= get(ev).data.checkInOpensAt &&
        request.time <= get(ev).data.checkInClosesAt;
    }

    // The code word is locked once the run is live AND its check-in has opened.
    // A run that isn't live has no open check-in, so its code word can still be set.
    function checkInHasOpened(runId) {
      let ev = eventPath(runId);
      return isRunLive(runId) &&
        get(ev).data.get('checkInOpensAt', null) is timestamp &&
        request.time >= get(ev).data.checkInOpensAt;
    }

    // A check-in doc is being created by this batch.
    function isCheckInCreatedInBatch(p) {
      return !exists(p) && existsAfter(p);
    }

    // An existing check-in doc is being edited by this batch.
    function isCheckInEditedInBatch(p) {
      return exists(p) && existsAfter(p) &&
        getAfter(p).data.get('updatedAt', '') != get(p).data.get('updatedAt', '');
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAttendee(a) {
      return a is map &&
        a.keys().hasOnly(['memberId', 'name', 'checkedIn', 'checkedInAt', 'rsvpDate']) &&
        a.keys().hasAll(['memberId', 'name', 'checkedIn', 'rsvpDate']) &&
        a.memberId is string && a.memberId.size() <= 128 &&
        a.name is string && a.name.size() <= 100 &&
        a.checkedIn is bool &&
        a.rsvpDate is string && a.rsvpDate.size() <= 40;
    }

    function isValidRun(data) {
      return data.keys().hasOnly([
               'id', 'title', 'date', 'time', 'locationName', 'meetingCoordinates',
               'address', 'distanceMiles', 'surface', 'elevationGainFt', 'description',
               'routeId', 'routeChoices', 'paceGroups', 'attendees', 'organizerName',
               'completed', 'specialEvent'
             ]) &&
             data.keys().hasAll([
               'id', 'title', 'date', 'time', 'locationName', 'address',
               'distanceMiles', 'surface', 'elevationGainFt', 'description',
               'paceGroups', 'attendees', 'organizerName'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.date is string && data.date.size() >= 8 && data.date.size() <= 25 &&
             data.time is string && data.time.size() >= 1 && data.time.size() <= 30 &&
             data.locationName is string && data.locationName.size() >= 1 && data.locationName.size() <= 200 &&
             data.address is string && data.address.size() <= 300 &&
             data.distanceMiles is number && data.distanceMiles > 0 && data.distanceMiles <= 500 &&
             data.surface is string && data.surface in ['Trail', 'Pavement', 'Mixed', 'Track'] &&
             data.elevationGainFt is number && data.elevationGainFt >= 0 && data.elevationGainFt <= 50000 &&
             data.description is string && data.description.size() <= 2000 &&
             data.paceGroups is list && data.paceGroups.size() <= 20 &&
             data.attendees is list && data.attendees.size() <= 500 &&
             data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 100 &&
             (!('routeId' in data) || (data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 128)) &&
             (!('routeChoices' in data) || (data.routeChoices is list && data.routeChoices.size() <= 20)) &&
             (!('completed' in data) || (data.completed is bool)) &&
             (!('specialEvent' in data) || (data.specialEvent is string && data.specialEvent.size() <= 50)) &&
             (!('meetingCoordinates' in data) || isValidCoordinates(data.meetingCoordinates));
    }

    // A runner may only add or remove their own RSVP entry; nothing else on the run changes.
    function isOwnRsvpToggle() {
      let before = resource.data.attendees;
      let after = request.resource.data.attendees;
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      let myKey = memberKeyFor(tokenEmail());
      return hasVerifiedEmail() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']) &&
        (
          (added.size() == 1 && removed.size() == 0 &&
           after.size() == before.size() + 1 &&
           isValidAttendee(added[0]) && added[0].memberId == myKey && added[0].checkedIn == false) ||
          (removed.size() == 1 && added.size() == 0 &&
           after.size() == before.size() - 1 &&
           removed[0].memberId == myKey)
        );
    }

    function isOwnLegacyClaim(id) {
      let me = tokenEmail();
      return hasVerifiedEmail() &&
        resource.data.get('claimedBy', null) == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt']) &&
        request.resource.data.claimedBy == memberKeyFor(me) &&
        request.resource.data.claimedAt is string &&
        (id in getAfter(userPath(me)).data.get('linkedLegacyIds', [])) &&
        !(id in get(userPath(me)).data.get('linkedLegacyIds', []));
    }

    function isValidGPXRoute(data) {
      return data.keys().hasOnly([
               'id', 'name', 'description', 'distanceMiles', 'elevationGainFt',
               'points', 'surface', 'difficulty', 'customDistanceLabel', 'isLoop',
               'maxLoops', 'directions', 'geoJson', 'externalLinks', 'notes',
               'gpxXml', 'createdAt', 'updatedAt', 'thumbnailUrl'
             ]) &&
             data.keys().hasAll([
               'id', 'name', 'description', 'distanceMiles', 'elevationGainFt',
               'points', 'surface', 'difficulty', 'createdAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.description is string && data.description.size() <= 2000 &&
             data.distanceMiles is number && data.distanceMiles >= 0 && data.distanceMiles <= 500 &&
             data.elevationGainFt is number && data.elevationGainFt >= 0 && data.elevationGainFt <= 50000 &&
             data.points is list && data.points.size() > 0 && data.points.size() <= 5000 &&
             data.surface is string && data.surface in ['Trail', 'Pavement', 'Mixed', 'Track'] &&
             data.difficulty is string && data.difficulty in ['Easy', 'Moderate', 'Challenging'] &&
             data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 40 &&
             (!('customDistanceLabel' in data) || (data.customDistanceLabel is string && data.customDistanceLabel.size() <= 50)) &&
             (!('isLoop' in data) || (data.isLoop is bool)) &&
             (!('maxLoops' in data) || (data.maxLoops is number && data.maxLoops >= 1 && data.maxLoops <= 20)) &&
             (!('directions' in data) || (data.directions is list && data.directions.size() <= 200) || (data.directions is string && data.directions.size() <= 400000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
             (!('gpxXml' in data) || (data.gpxXml is string && data.gpxXml.size() <= 800000)) &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000));
    }

    // Public leaderboard projection. Deliberately has no email or other PII.
    function isValidMember(data) {
      return data.keys().hasOnly([
               'id', 'name', 'avatarUrl', 'totalRuns', 'totalMiles', 'runCount',
               'walkCount', 'petRunCount', 'streak', 'favoritePace',
               'unlockedBadgeIds', 'badgeCounts', 'joinedDate'
             ]) &&
             data.keys().hasAll([
               'id', 'name', 'totalRuns', 'totalMiles', 'streak',
               'favoritePace', 'unlockedBadgeIds', 'joinedDate'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.totalRuns is number && data.totalRuns >= 0 && data.totalRuns <= 100000 &&
             data.totalMiles is number && data.totalMiles >= 0 && data.totalMiles <= 1000000 &&
             data.streak is number && data.streak >= 0 && data.streak <= 10000 &&
             data.favoritePace is string && data.favoritePace.size() >= 1 && data.favoritePace.size() <= 50 &&
             data.unlockedBadgeIds is list && data.unlockedBadgeIds.size() <= 100 &&
             data.joinedDate is string && data.joinedDate.size() >= 4 && data.joinedDate.size() <= 35 &&
             (!('runCount' in data) || data.runCount is number) &&
             (!('walkCount' in data) || data.walkCount is number) &&
             (!('petRunCount' in data) || data.petRunCount is number) &&
             (!('badgeCounts' in data) || data.badgeCounts is map) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000));
    }

    // The leaderboard row must mirror the user doc as it stands after this batch.
    function memberMirrorsUser(data, email) {
      let u = getAfter(userPath(email)).data;
      return data.name == u.displayName &&
        data.totalRuns == u.totalRuns &&
        data.totalMiles == u.totalMiles &&
        data.unlockedBadgeIds == u.unlockedBadgeIds;
    }

    function isValidCheckIn(data) {
      return data.keys().hasOnly([
               'id', 'runId', 'date', 'time', 'userEmail', 'activity', 'distanceChoice',
               'actualMiles', 'createdAt', 'updatedAt', 'runnerName', 'routeName',
               'loops', 'withPet', 'source', 'codeWord'
             ]) &&
             data.keys().hasAll([
               'id', 'runId', 'date', 'time', 'userEmail', 'activity', 'distanceChoice',
               'actualMiles', 'createdAt', 'updatedAt'
             ]) &&
             data.runId is string && data.runId.size() >= 1 && data.runId.size() <= 128 &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 180 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.time is string && data.time.size() >= 1 && data.time.size() <= 30 &&
             data.userEmail is string && data.userEmail.size() <= 150 && isValidEmail(data.userEmail) &&
             data.activity is string && data.activity in ['running', 'walking'] &&
             (
               (data.distanceChoice is string && data.distanceChoice.size() <= 100) ||
               (data.distanceChoice is number && data.distanceChoice >= 0 && data.distanceChoice <= 100)
             ) &&
             data.actualMiles is number && data.actualMiles >= 0 && data.actualMiles <= 50 &&
             data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 40 &&
             data.updatedAt is string && data.updatedAt.size() >= 8 && data.updatedAt.size() <= 40 &&
             (!('runnerName' in data) || (data.runnerName is string && data.runnerName.size() <= 100)) &&
             (!('routeName' in data) || (data.routeName is string && data.routeName.size() <= 150)) &&
             (!('loops' in data) || (data.loops is number && data.loops >= 0 && data.loops <= 20)) &&
             (!('withPet' in data) || (data.withPet is bool)) &&
             (!('codeWord' in data) || (data.codeWord is string && data.codeWord.size() <= 60)) &&
             (!('source' in data) || (data.source is string && data.source in ['pwa', 'admin', 'legacy_import']));
    }

    function isValidUserProfile(data) {
      return data.keys().hasOnly([
               'email', 'firstName', 'lastName', 'displayName', 'shirtSize',
               'pre2021Runs', 'loggedRuns', 'totalRuns', 'totalMiles', 'runCount',
               'walkCount', 'linkedLegacyNames', 'unlockedBadgeIds', 'role',
               'createdAt', 'age', 'birthday', 'city', 'zipCode', 'preferredPace',
               'petRunCount', 'distanceCounts', 'firstRunDate', 'badgeCounts',
               'emergencyContact', 'lastCheckInDate', 'lastCheckInRunId', 'linkedLegacyIds',
               'legacyEventRuns', 'currentStreakWeeks', 'longestStreakWeeks'
             ]) &&
             data.keys().hasAll([
               'email', 'firstName', 'lastName', 'displayName', 'shirtSize',
               'pre2021Runs', 'loggedRuns', 'totalRuns', 'totalMiles', 'runCount',
               'walkCount', 'linkedLegacyNames', 'unlockedBadgeIds', 'role',
               'createdAt'
             ]) &&
             data.email is string && data.email.size() <= 150 && isValidEmail(data.email) &&
             data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.shirtSize is string && data.shirtSize.size() >= 1 && data.shirtSize.size() <= 50 &&
             data.pre2021Runs is number && data.pre2021Runs >= 0 && data.pre2021Runs <= 100000 &&
             data.loggedRuns is number && data.loggedRuns >= 0 && data.loggedRuns <= 100000 &&
             data.totalRuns is number && data.totalRuns >= 0 && data.totalRuns <= 100000 &&
             data.totalMiles is number && data.totalMiles >= 0 && data.totalMiles <= 1000000 &&
             data.runCount is number && data.runCount >= 0 && data.runCount <= 100000 &&
             data.walkCount is number && data.walkCount >= 0 && data.walkCount <= 100000 &&
             data.linkedLegacyNames is list && data.linkedLegacyNames.size() <= 100 &&
             data.unlockedBadgeIds is list && data.unlockedBadgeIds.size() <= 100 &&
             data.role is string && data.role in ['member', 'organizer', 'admin', 'guest'] &&
             data.createdAt is string && data.createdAt.size() >= 8 && data.createdAt.size() <= 40 &&
             (!('age' in data) || (data.age is number && data.age >= 0 && data.age <= 150)) &&
             (!('birthday' in data) || (data.birthday is string && data.birthday.size() <= 20)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('zipCode' in data) || (data.zipCode is string && data.zipCode.size() <= 20)) &&
             (!('preferredPace' in data) || (data.preferredPace is string && data.preferredPace.size() <= 50)) &&
             (!('petRunCount' in data) || (data.petRunCount is number && data.petRunCount >= 0 && data.petRunCount <= 100000)) &&
             (!('firstRunDate' in data) || (data.firstRunDate is string && data.firstRunDate.size() <= 30)) &&
             (!('lastCheckInDate' in data) || (data.lastCheckInDate is string && data.lastCheckInDate.size() <= 30)) &&
             (!('lastCheckInRunId' in data) || (data.lastCheckInRunId is string && data.lastCheckInRunId.size() <= 128)) &&
             (!('linkedLegacyIds' in data) || (data.linkedLegacyIds is list && data.linkedLegacyIds.size() <= 50)) &&
             (!('legacyEventRuns' in data) || (data.legacyEventRuns is int && data.legacyEventRuns >= 0)) &&
             (!('currentStreakWeeks' in data) || (data.currentStreakWeeks is int && data.currentStreakWeeks >= 0)) &&
             (!('longestStreakWeeks' in data) || (data.longestStreakWeeks is int && data.longestStreakWeeks >= 0)) &&
             (!('distanceCounts' in data) || (data.distanceCounts is map)) &&
             (!('badgeCounts' in data) || (data.badgeCounts is map)) &&
             (!('emergencyContact' in data) || (data.emergencyContact is map));
    }

    // Fields a runner can never change on their own profile after sign-up.
    function coreProfileFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'email', 'role', 'createdAt'
      ]);
    }

    // Legacy claim fields: only change through isLegacyClaimBacked (or an admin).
    function legacyFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'pre2021Runs', 'linkedLegacyNames', 'linkedLegacyIds', 'legacyEventRuns'
      ]);
    }

    // A self-created profile starts empty; runs only arrive via claims and check-ins.
    function isFreshProfile(d) {
      return d.pre2021Runs == 0 && d.loggedRuns == 0 && d.totalRuns == 0 &&
        d.totalMiles == 0 && d.runCount == 0 && d.walkCount == 0 &&
        d.linkedLegacyNames.size() == 0 && d.unlockedBadgeIds.size() == 0 &&
        d.get('linkedLegacyIds', []).size() == 0 &&
        d.get('legacyEventRuns', 0) == 0 &&
        d.get('petRunCount', 0) == 0;
    }

    // Claiming one legacy name: the legacy doc goes from unclaimed to this runner
    // in the same batch, and the totals grow by exactly that name's counts.
    function isLegacyClaimBacked(email) {
      let before = resource.data.get('linkedLegacyIds', []);
      let after = request.resource.data.get('linkedLegacyIds', []);
      let added = after.removeAll(before);
      return added.size() == 1 &&
        after.size() == before.size() + 1 &&
        before.removeAll(after).size() == 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'linkedLegacyIds', 'linkedLegacyNames', 'pre2021Runs', 'legacyEventRuns', 'totalRuns'
        ]) &&
        claimAddsCounts(email, added[0]);
    }

    function claimAddsCounts(email, id) {
      let d = request.resource.data;
      let o = resource.data;
      let lp = getAfter(legacyPath(id)).data;
      return exists(legacyPath(id)) &&
        get(legacyPath(id)).data.get('claimedBy', null) == null &&
        lp.claimedBy == memberKeyFor(email) &&
        d.pre2021Runs == o.pre2021Runs + lp.oldCount &&
        d.get('legacyEventRuns', 0) == o.get('legacyEventRuns', 0) + lp.newCount &&
        d.totalRuns == o.totalRuns + lp.oldCount + lp.newCount;
    }

    // Badges and streaks are recalculated on the client from the runner's dated
    // history (claimed legacy sign-ins + check-ins) after a claim; nothing else changes.
    function isBadgeRefreshOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'unlockedBadgeIds', 'badgeCounts', 'currentStreakWeeks', 'longestStreakWeeks'
      ]);
    }

    function roleChanged() {
      return request.resource.data.get('role', 'member') != resource.data.get('role', 'member');
    }

    // Stats a runner may only change while writing a valid check-in in the same batch.
    function statsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'totalRuns', 'loggedRuns', 'totalMiles', 'runCount', 'walkCount',
        'petRunCount', 'distanceCounts', 'unlockedBadgeIds', 'badgeCounts',
        'lastCheckInDate', 'lastCheckInRunId', 'firstRunDate', 'currentStreakWeeks', 'longestStreakWeeks'
      ]);
    }

    function isStatsChangeBackedByCheckIn(email) {
      let d = request.resource.data;
      let o = resource.data;
      let p = checkinPath(d.get('lastCheckInRunId', ''), email);
      return d.get('lastCheckInRunId', null) is string &&
        (
          (isCheckInCreatedInBatch(p) &&
           d.totalRuns == o.totalRuns + 1 &&
           d.loggedRuns == o.loggedRuns + 1 &&
           d.runCount + d.walkCount == o.runCount + o.walkCount + 1) ||
          (isCheckInEditedInBatch(p) &&
           d.totalRuns == o.totalRuns &&
           d.loggedRuns == o.loggedRuns &&
           d.runCount + d.walkCount == o.runCount + o.walkCount)
        ) &&
        d.get('petRunCount', 0) <= o.get('petRunCount', 0) + 1 &&
        d.totalMiles <= o.totalMiles + getAfter(p).data.actualMiles + 0.01;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. RUNS — public schedule. Staff manage runs; runners may only toggle their own RSVP.
    match /runs/{runId} {
      allow read: if true;

      allow create: if isStaff() &&
                       isValidRun(request.resource.data) &&
                       request.resource.data.id == runId;

      allow update: if isValidRun(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.id == runId &&
                       (isStaff() || isOwnRsvpToggle());

      allow delete: if isStaff();
    }

    // 2. ROUTES — public library, staff-managed.
    match /routes/{routeId} {
      allow read: if true;

      allow create: if isStaff() &&
                       isValidGPXRoute(request.resource.data) &&
                       request.resource.data.id == routeId;

      allow update: if isStaff() &&
                       isValidGPXRoute(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.id == routeId &&
                       request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isStaff();
    }

    // 3. MEMBERS — public leaderboard projection keyed by memberKey (hashed email).
    match /members/{memberKey} {
      allow read: if true;

      allow create, update: if isValidMember(request.resource.data) &&
                               request.resource.data.id == memberKey &&
                               (
                                 isAdmin() ||
                                 (hasVerifiedEmail() &&
                                  memberKey == memberKeyFor(tokenEmail()) &&
                                  memberMirrorsUser(request.resource.data, tokenEmail()))
                               );

      allow delete: if isAdmin();
    }

    // 4. CHECKINS — private audit log. One per runner per run: doc ID is `${runId}_${email}`.
    match /checkins/{checkinId} {
      allow read: if isStaff() ||
                     (hasVerifiedEmail() && resource.data.userEmail == tokenEmail());

      allow create: if isValidCheckIn(request.resource.data) &&
                       checkinId == request.resource.data.runId + '_' + request.resource.data.userEmail &&
                       request.resource.data.id == checkinId &&
                       (
                         isStaff() ||
                         (isUserEmailOwner(request.resource.data.userEmail) &&
                          request.resource.data.get('source', 'pwa') == 'pwa' &&
                          codeWordMatches(request.resource.data.runId, request.resource.data.date, request.resource.data.get('codeWord', '')) &&
                          isInsideCheckInWindow(request.resource.data.runId, request.resource.data.date))
                       );

      allow update: if isValidCheckIn(request.resource.data) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['id', 'runId', 'date', 'userEmail', 'createdAt']) &&
                       (
                         isStaff() ||
                         (isUserEmailOwner(resource.data.userEmail) &&
                          request.resource.data.get('source', 'pwa') == 'pwa' &&
                          codeWordMatches(request.resource.data.runId, request.resource.data.date, request.resource.data.get('codeWord', '')) &&
                          isInsideCheckInWindow(request.resource.data.runId, request.resource.data.date))
                       );

      allow delete: if isStaff();
    }

    // 5. USERS — private profiles. Doc ID is the lowercase email.
    // Staff can read the roster; only admins can create, edit or delete other
    // people's profiles. Roles change only by an admin, never on your own profile.
    match /users/{email} {
      allow get: if isUserEmailOwner(email) || isStaff();
      allow list: if isStaff();

      allow create: if isValidUserProfile(request.resource.data) &&
                       request.resource.data.email == email &&
                       (
                         (isAdmin() && !isUserEmailOwner(email)) ||
                         (isUserEmailOwner(email) &&
                          isFreshProfile(request.resource.data) &&
                          (request.resource.data.role == 'member' ||
                           (request.resource.data.role == 'admin' && isBootstrapAdminEmail())))
                       );

      allow update: if isValidUserProfile(request.resource.data) &&
                       (
                         (isAdmin() && (!isUserEmailOwner(email) || !roleChanged())) ||
                         (isUserEmailOwner(email) &&
                          coreProfileFieldsUnchanged() &&
                          (
                            (legacyFieldsUnchanged() &&
                             (statsUnchanged() || isStatsChangeBackedByCheckIn(email) || isBadgeRefreshOnly())) ||
                            isLegacyClaimBacked(email)
                          ))
                       );

      allow delete: if isAdmin() && !isUserEmailOwner(email);
    }

    // 6. BADGES / 7. SPECIAL EVENTS — public catalog, admin-managed.
    match /badges/{badgeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /special_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 8. MILESTONE ALERTS — private gear queue.
    // Runners may create exactly one alert per milestone, only alongside the
    // check-in that brought their total to that milestone.
    match /milestone_alerts/{alertId} {
      allow read: if isStaff() ||
                     (hasVerifiedEmail() && resource.data.userEmail == tokenEmail());

      allow create: if isStaff() ||
                       (hasVerifiedEmail() &&
                        request.resource.data.keys().hasOnly([
                          'id', 'userEmail', 'runnerName', 'shirtSize', 'milestoneRuns',
                          'milestoneName', 'reward', 'perks', 'date', 'time', 'fulfilled', 'runId'
                        ]) &&
                        request.resource.data.id == alertId &&
                        request.resource.data.userEmail == tokenEmail() &&
                        request.resource.data.milestoneRuns is int &&
                        request.resource.data.milestoneRuns >= 1 &&
                        alertId == 'm' + string(request.resource.data.milestoneRuns) + '_' + tokenEmail() &&
                        request.resource.data.fulfilled == false &&
                        request.resource.data.runId is string &&
                        isCheckInCreatedInBatch(checkinPath(request.resource.data.runId, tokenEmail())) &&
                        getAfter(userPath(tokenEmail())).data.totalRuns == request.resource.data.milestoneRuns);

      allow update, delete: if isStaff();
    }

    // 9. MEETUP EVENTS — public check-in info for one run. Doc ID is the run ID.
    // The code word lives in meetup_secrets (staff) and meetup_codes (lookup key).
    match /meetup_events/{eventId} {
      allow read: if true;
      allow create, update: if isStaff() && !('codeWord' in request.resource.data) &&
                               // A live run with check-in open can't be switched to "not live"
                               // (that would unlock its code word).
                               (!checkInHasOpened(eventId) ||
                                request.resource.data.get('codeWordSet', true) != false);
      allow delete: if isStaff();
    }

    // 9b. MEETUP SECRETS — the run's code word, staff only.
    // Can be set or changed until the run is live and its check-in has opened;
    // then it's locked (re-saving the same word is fine).
    match /meetup_secrets/{eventId} {
      allow read: if isStaff();
      allow create: if isStaff() && !checkInHasOpened(eventId);
      allow update: if isStaff() &&
                       (request.resource.data.codeWord == resource.data.codeWord ||
                        !checkInHasOpened(eventId));
      allow delete: if isAdmin();
    }

    // 9c. MEETUP CODES — lookup key sha256("<date>:<CODEWORD>") -> { runId, date }.
    // Signed-in runners may get a key (to find which run a code word belongs to)
    // but never list them. Creating fails if the word is already used that day.
    match /meetup_codes/{codeKey} {
      allow get: if hasVerifiedEmail();
      allow list: if false;
      allow create: if isStaff() &&
                       request.resource.data.keys().hasOnly(['runId', 'date']) &&
                       request.resource.data.runId is string &&
                       request.resource.data.date is string &&
                       !checkInHasOpened(request.resource.data.runId);
      allow update: if false;
      // Admins may also remove it later, e.g. when deleting a run that already happened.
      allow delete: if isAdmin() || (isStaff() && !checkInHasOpened(resource.data.runId));
    }

    // 10. CLUB SETTINGS — public read, admin write.
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 11. LEGACY (old app) DATA
    // legacy_index/pool: { entries: [{id, name, oldCount, newCount}] } — one read for name search.
    match /legacy_index/{docId} {
      allow read: if hasVerifiedEmail();
      allow write: if isAdmin();
    }

    // legacy_profiles/{id}: one per old sign-in name. claimedBy = claimer's memberKey.
    // A runner can claim an unclaimed name only together with the matching
    // profile update (isLegacyClaimBacked). Only admins unclaim or reassign.
    match /legacy_profiles/{id} {
      allow read: if hasVerifiedEmail();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwnLegacyClaim(id);
    }

    // legacy_history/{id}: { events: [{d, t, c}] } — dated sign-ins since 2021.
    // Private: the claimer and staff only.
    match /legacy_history/{id} {
      allow read: if isStaff() ||
                     (hasVerifiedEmail() &&
                      get(legacyPath(id)).data.get('claimedBy', null) == memberKeyFor(tokenEmail()));
      allow write: if isAdmin();
    }

    // 12. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
